.DS_Store

# Scratch directory used by bin/update-requirements.sh
/.uv-compile/

# Build outputs
/sbom.spdx.json

# Throwaway CA staged by bin/smoke-test.sh for the run-time injection check
/.smoke-ca.*

# Build-time and runtime CA certificates. See certs/README.md.
/certs/*
!/certs/.keep
!/certs/README.md
