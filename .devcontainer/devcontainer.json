// Devcontainer definition. See https://containers.dev/implementors/json_reference/
//
// The image carries every tool; no Features are used, so a rebuild pulls
// nothing that is not pinned in versions.env.
{
  "name": "my-dev-container",

  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      // Match these to the host user when bind mounts would otherwise leave
      // root-owned files in the workspace. Docker Desktop on macOS maps uids
      // for you, so the defaults are fine there.
      "USERNAME": "dev",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },

  "runArgs": [
    // tcpdump and mtr need these even though the binaries carry file
    // capabilities; the container has to be granted the capability first.
    "--cap-add=NET_RAW",
    "--cap-add=NET_ADMIN",
    // Reap zombies from long-lived dev processes.
    "--init"
  ],

  "mounts": [
    // docker-outside-of-docker: the CLI in this image drives the host daemon.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",

    // The corporate proxy root, injected at run time rather than baked into the
    // image, so the image itself can be built and published from public CI.
    // Create the host directory and drop the PEM in it before first use:
    //
    //   mkdir -p ~/.config/ca-certificates
    //   security find-certificate -a -c "Zscaler" -p /Library/Keychains/System.keychain \
    //     > ~/.config/ca-certificates/zscaler-root.crt
    //
    // An empty or absent directory is fine; the container then trusts only the
    // public roots.
    "source=${localEnv:HOME}/.config/ca-certificates,target=/run/secrets/ca-certificates,type=bind,readonly",

    // Host credentials and config. Remove any of these you would rather keep
    // out of the container.
    "source=${localEnv:HOME}/.kube,target=/home/dev/.kube,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.aws,target=/home/dev/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind,consistency=cached",

    // Shell history survives a rebuild. See HISTFILE in containerEnv.
    "source=my-dev-container-history,target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    "TZ": "US/Eastern",
    "HISTFILE": "/commandhistory/.bash_history"
  },

  "remoteUser": "dev",

  // Both of these reconcile things that are only knowable at run time: the
  // socket's group ownership comes from the host, and the proxy root comes from
  // the mount above. The image entrypoint also runs init-ca-certs, but a
  // devcontainer runtime may replace the entrypoint, so it is repeated here.
  // Running it twice is harmless.
  "postStartCommand": {
    "docker-socket": "sudo /usr/local/bin/init-docker-socket",
    "ca-certs": "sudo /usr/local/bin/init-ca-certs"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "rust-lang.rust-analyzer",
        "anthropic.claude-code",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "go.gopath": "/home/dev/go",
        "go.goroot": "/usr/local/go"
      }
    }
  }
}
