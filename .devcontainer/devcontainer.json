// Devcontainer definition. See https://containers.dev/implementors/json_reference/
//
// The image carries every tool; no Features are used, so a rebuild pulls
// nothing that is not pinned in versions.env.
{
  "name": "my-dev-container",

  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      // The container user's uid/gid have to match the host user's. Bind mounts
      // carry the host's numeric ownership straight through, so a mismatch
      // makes every file in the workspace look like it belongs to someone else:
      // git rejects the repository with "detected dubious ownership", and
      // anything the container writes lands owned by the wrong user on the host.
      //
      // Docker Desktop's old osxfs remapped ownership on the way through, which
      // is why this used to be a Linux-only concern; VirtioFS and gRPC-FUSE do
      // not, so macOS needs it set as well.
      //
      // Rather than pin one person's numbers here, take them from the host
      // environment and fall back to the image defaults. Export these where
      // every shell will see them -- ~/.zshenv, not ~/.zshrc -- because a
      // runtime started outside a login shell inherits nothing else:
      //
      //   echo "export HOST_UID=$(id -u)" >> ~/.zshenv
      //   echo "export HOST_GID=$(id -g)" >> ~/.zshenv
      //
      // $UID and $EUID are shell variables and are not exported, so they cannot
      // be read here; the names have to be ones you export yourself.
      //
      // On macOS the primary group is normally staff (gid 20), which collides
      // with dialout in Debian; the Dockerfile joins the existing group in that
      // case rather than failing the build.
      "USERNAME": "dev",
      "USER_UID": "${localEnv:HOST_UID:1000}",
      "USER_GID": "${localEnv:HOST_GID:1000}"
    }
  },

  // Runs on the host before the container is created. `docker run --mount
  // type=bind` fails outright when the source path does not exist -- only the
  // older `-v` form creates it -- and devcontainer.json cannot make a mount
  // conditional, so every host path in "mounts" below has to be there already.
  // This creates the ones that are not, which is what lets the list stay
  // uniform across hosts that have not configured every tool.
  "initializeCommand": "bash ${localWorkspaceFolder}/bin/init-devcontainer-mounts.sh",

  "runArgs": [
    // tcpdump and mtr need these even though the binaries carry file
    // capabilities; the container has to be granted the capability first.
    "--cap-add=NET_RAW",
    "--cap-add=NET_ADMIN",
    // Reap zombies from long-lived dev processes.
    "--init"
  ],

  // Tilt's web UI. VS Code discovers listening ports on its own, but the
  // devcontainer CLI does not, so name it here for both.
  "forwardPorts": [10350],

  "mounts": [
    // docker-outside-of-docker: the CLI in this image drives the host daemon.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",

    // The corporate proxy root, injected at run time rather than baked into the
    // image, so the image itself can be built and published from public CI.
    // Create the host directory and drop the PEM in it before first use:
    //
    //   mkdir -p ~/.config/ca-certificates
    //   security find-certificate -a -c "Zscaler" -p /Library/Keychains/System.keychain \
    //     > ~/.config/ca-certificates/zscaler-root.crt
    //
    // An empty directory is fine; the container then trusts only the public
    // roots. initializeCommand below creates it when it is absent, because a
    // bind mount with a missing source aborts the container start.
    "source=${localEnv:HOME}/.config/ca-certificates,target=/run/secrets/ca-certificates,type=bind,readonly",

    // Host credentials and config. Remove any of these you would rather keep
    // out of the container.
    "source=${localEnv:HOME}/.kube,target=/home/dev/.kube,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.aws,target=/home/dev/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.git,target=/home/dev/.git,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitignore,target=/home/dev/.gitignore,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/nvim,target=/home/dev/.config/nvim,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/k8s,target=/home/dev/.config/k8s,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/jj,target=/home/dev/.config/jj,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/git,target=/home/dev/.config/git,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/kargo,target=/home/dev/.config/kargo,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/k9s,target=/home/dev/.config/k9s,type=bind,consistency=cached",

    // Shell history survives a rebuild. See HISTFILE in containerEnv.
    "source=my-dev-container-history,target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    "TZ": "US/Central",
    "HISTFILE": "/commandhistory/.bash_history"
  },

  // A Linux host rewrites the container user's uid/gid to match the local user
  // here, which would make the build args above redundant. It is a no-op on
  // macOS, so the args carry the mapping instead.
  "updateRemoteUserUID": true,
  "remoteUser": "dev",
  "containerUser": "dev",

  // These reconcile things that are only knowable at run time: the socket's
  // group ownership comes from the host, the proxy root comes from the mount
  // above, and the history volume keeps whatever ownership it was created with,
  // which is stale after the uid in the build args changes. The image
  // entrypoint also runs init-ca-certs, but a devcontainer runtime may replace
  // the entrypoint, so it is repeated here. Running it twice is harmless.
  "postStartCommand": {
    "docker-socket": "sudo /usr/local/bin/init-docker-socket",
    "ca-certs": "sudo /usr/local/bin/init-ca-certs",
    "history": "sudo chown -R \"$(id -u):$(id -g)\" /commandhistory"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "rust-lang.rust-analyzer",
        "anthropic.claude-code",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "go.gopath": "/home/dev/go",
        "go.goroot": "/usr/local/go"
      }
    }
  }
}
