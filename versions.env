# Pinned versions for tools installed from upstream release artifacts.
#
# Bump a value here, then run `make update-versions` to regenerate checksums.txt.
# Do not hand-edit checksums.txt.
#
# Tools installed from Debian packages (psql, mysql, redis-cli, tmux, the
# network utilities, the compiler toolchain) are pinned by the base image tag
# rather than individually.

DEBIAN_TAG=13-slim

# --- language toolchains ---------------------------------------------------
GO_VERSION=1.27.0
RUSTUP_VERSION=1.29.0
RUST_VERSION=1.98.0
NVM_VERSION=0.40.7
# Node is installed by nvm at build time and becomes the default version.
# nvm verifies the download against nodejs.org's SHASUMS256.txt itself.
NODE_VERSION=24.19.0

# --- kubernetes ------------------------------------------------------------
KUBECTL_VERSION=1.36.4
STERN_VERSION=1.34.0
K9S_VERSION=0.51.0
# Kargo's CLI only; the controllers it talks to run in the cluster.
KARGO_VERSION=1.11.2
# krew, the kubectl plugin manager. Only krew itself is pinned here: the plugins
# it installs come from the krew-index at build time, and krew has no way to ask
# for a specific plugin version. See the krew step in the Dockerfile.
KREW_VERSION=0.5.0
# Tilt, for the inner loop against a live cluster. Its own install.sh is not
# used: it resolves the version at run time and would leave the build unpinned.
TILT_VERSION=0.37.7

# --- version control -------------------------------------------------------
# Jujutsu ships a statically linked musl build, which runs as-is on Debian.
JJ_VERSION=0.44.0

# --- editor, http, messaging ----------------------------------------------
NEOVIM_VERSION=0.12.5
HURL_VERSION=8.0.1
NATS_VERSION=0.4.0

# --- docker client (docker-outside-of-docker) ------------------------------
# Only the client binary is taken from the static bundle; no daemon runs here.
DOCKER_VERSION=29.7.2
BUILDX_VERSION=0.36.1
COMPOSE_VERSION=5.5.0

# AWS CLI v2 is verified by GPG signature at build time rather than by a pinned
# digest, so it is not present in checksums.txt.
AWSCLI_VERSION=2.36.30

# Installed into a virtualenv with pip. Hashes come from the generated
# requirements.txt, not from checksums.txt.
PGCLI_VERSION=4.5.0
MYCLI_VERSION=2.17.0

# Claude Code. The installer resolves and verifies its own SHA-256 against a
# signed release manifest, so there is no entry in checksums.txt. "stable" or an
# exact version (e.g. 2.1.231); the CLI self-updates at runtime either way.
CLAUDE_VERSION=stable
